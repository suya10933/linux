/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "bcm2711-rpi-cm4.dtsi"

/ {
	model = "SHH Handheld";

	compatible = "suya,shh",
				 "raspberrypi,4-compute-module",
				 "brcm,bcm2711";
};

&gpio {
	shh_spi0_pins: shh-spi0-pins {
		brcm,pins = <9 10 11>;
		brcm,function = <BCM2835_FSEL_ALT0>;
	};
};

spi0: &spi {
	pinctrl-names = "default";
	pinctrl-0 = <&shh_spi0_pins>;
	cs-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
	status = "okay";

	shh_mcu: mcu@0 {
		compatible = "shh,shh-mcu";
		reg = <0>;
		spi-max-frequency = <10000000>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "LCD_RESET";
	};
};

&pcie0 {
	status = "disabled";
};

&i2s {
	pinctrl-names = "default";
	pinctrl-0 = <&pcm_gpio18>;
	status = "disabled";
};

&vc4 {
	status = "okay";
};

&pixelvalve0 {
	status = "okay";
};

&vec {
	status = "disabled";
};

&dsi0 {
	status = "okay";

	port {
		dsi0_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};

	panel@0 {
		compatible = "eastrising,er-tft050-10", "ilitek,ili9881c";
		reg = <0>;
		reset-gpios = <&shh_mcu 0 GPIO_ACTIVE_LOW>;
		backlight = <&shh_mcu>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};
};

&sdhci {
	status = "disabled";
};

/ {
	aliases {
		mmc0 = &emmc2;
		mmc1 = &sdhci;
	};
};
